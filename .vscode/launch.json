{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Backend",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/clyra",
      "cwd": "${workspaceFolder}",
      "output": "${workspaceFolder}/backend/clyra",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "CLYRA_ENV": "development",
        "CLYRA_ADDR": "127.0.0.1:8080",
        "CLYRA_APP_ORIGIN": "http://localhost:3000"
      }
    },
    {
      "name": "Vue: Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host localhost --port 3000 --strictPort",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Clyra",
      "configurations": ["Go: Backend", "Vue: Frontend"],
      "stopAll": true,
      "presentation": {
        "order": 1
      }
    }
  ]
}
