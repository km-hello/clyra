# 本地开发示例；应用不自动读取 .env，需在启动时注入环境变量。

# 运行环境：development / production。
CLYRA_ENV=development

# 监听地址；Docker 使用 :8080。
CLYRA_ADDR=127.0.0.1:8080

# 前端来源（协议、域名和端口，无路径）；生产环境必须使用 HTTPS。
CLYRA_APP_ORIGIN=http://localhost:5173

# 必填：随机会话密钥，使用 openssl rand -hex 32 生成并固定保存。
CLYRA_SESSION_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET

# 数据库路径；Docker 使用 /app/data/clyra.db，并持久化 /app/data。
CLYRA_DATABASE_PATH=./data/clyra.db

# 前端构建目录；Docker 使用 /app/dist。
CLYRA_STATIC_DIR=./frontend/dist

# Telegram Bot Token，可选；Chat ID 在页面设置。
CLYRA_TELEGRAM_BOT_TOKEN=

# SerpAPI 密钥，可选，用于搜索品牌图标。
CLYRA_SERP_API_KEY=
